# Address of the deployed `contract` (Contract.sol) on Polkadot Hub TestNet (Paseo).
# Deploy the PVM blob first, then paste the resulting contract address here.
#
#   export ETH_RPC_URL=https://eth-rpc-testnet.polkadot.io/
#   cast send --private-key $PRIVATE_KEY --create \
#     "$(xxd -p -c 99999 ../target/contract.release.polkavm)" --json
#
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional RPC override (defaults to the public Paseo Hub eth-rpc endpoint).
NEXT_PUBLIC_RPC_URL=https://eth-rpc-testnet.polkadot.io/
